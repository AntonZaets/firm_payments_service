{
  "description": "Run repository pre-commit checks after patches, and checks and tests before finishing a turn.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Write|Edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && { make check >&2 || exit 2; }",
            "timeout": 600,
            "statusMessage": "Running pre-commit checks"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && { make check >&2 || exit 2; } && printf '{}\\n'",
            "timeout": 600,
            "statusMessage": "Running final pre-commit checks"
          },
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && { make test >&2 || exit 2; } && printf '{}\\n'",
            "timeout": 600,
            "statusMessage": "Running final tests"
          }
        ]
      }
    ]
  }
}
