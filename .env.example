# Local development credentials only. PostgreSQL is internal to Compose.
POSTGRES_USER=firm_payments
POSTGRES_PASSWORD=local-development
POSTGRES_DB=firm_payments
DATABASE_URL=postgresql+psycopg://firm_payments:local-development@db:5432/firm_payments
LOG_LEVEL=INFO
APP_PORT=8000
OPERATIONAL_API_KEY=local-operational-key
MAX_PAYMENTS=1000
MAX_DESCRIPTION_LENGTH=1000
SERIALIZATION_ATTEMPTS=3
SERIALIZATION_RETRY_DELAY_MS=50
STATEMENT_TIMEOUT_MS=60000
LOCK_TIMEOUT_MS=60000
RETRY_AFTER_SECONDS=1
